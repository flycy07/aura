# Copia questo file in `.env` e compila i valori.
#
# Jamendo: catalogo Creative Commons (anche italiano).
# Client id gratuita: https://developer.jamendo.com
# È un identificatore pubblico dell'app, non una password: viene incorporato nel bundle
# a ogni build. Se non la imposti, l'app chiede di inserirla e la salva solo sul dispositivo.
VITE_JAMENDO_CLIENT_ID=


# Chiave YouTube Data API v3: usata dal Worker, mai inclusa nel bundle del browser.
YOUTUBE_API_KEY=
